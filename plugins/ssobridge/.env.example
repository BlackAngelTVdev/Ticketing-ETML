# =============================================================================
# GLPI SSO Bridge configuration
#
# Copy this file to `.env` and fill in your values. Real environment
# variables always win over this file (this is how Docker deployments pass
# the configuration, see docker-compose.prod.yaml / .env at the repo root).
# =============================================================================

# Base URL of the SSO portal (the bridge API lives under this URL).
SSO_PORTAL_URL=https://apps.pm2etml.ch/auth/

# Access token (API key) delivered by the SSO portal maintainer.
# "PLEASE ASK FOR IT" in the original standalone config.
SSO_ACCESS_TOKEN=

# Full URL of this plugin callback, e.g. https://glpi.example.org/plugins/ssobridge/front/callback.php
# Leave empty to build it automatically from each request.
SSO_CALLBACK_URI=

# Auto-create the GLPI user when the SSO account has no match (1 = yes).
SSO_AUTO_CREATE_USERS=1

# Profile assigned to auto-created users:
#   (empty) -> GLPI default profile (the one flagged as default)
#   none    -> no profile (an administrator must grant rights afterwards)
#   Name    -> any existing profile name, e.g. Self-Service
SSO_DEFAULT_PROFILE=

# Redirect anonymous visitors of the GLPI login page straight to the SSO
# portal (1) instead of showing the login form with the "Login with SSO"
# button (0). Append ?nosso=1 to any GLPI URL to keep the regular login form.
SSO_AUTO_REDIRECT=0
